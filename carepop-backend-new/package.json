    "@supabase/supabase-js": "^2.44.4",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.5.1",
    "openai": "^5.6.0",
    "postgres": "^3.4.7",
    "resend": "^3.5.0",
    "svix": "^1.67.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "nodemon": "^3.1.4",
