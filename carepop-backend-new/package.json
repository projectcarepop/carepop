{
  "name": "carepop-backend-new",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node -r dotenv/config src/index.ts",
    "dev": "dotenv -- nodemon --watch src --ext ts --exec ts-node -r dotenv/config src/index.ts",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
