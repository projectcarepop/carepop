{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@/drizzle/*": ["./drizzle/*"]
    }
  },
  "include": ["app/**/*.ts", "drizzle/**/*.ts"],
  "exclude": ["node_modules"]
} 