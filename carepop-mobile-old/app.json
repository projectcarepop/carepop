{
  "expo": {
    "name": "CarePop Mobile",
    "slug": "carepop",
    "version": "1.0.0",
    "entryPoint": "./index.ts",
    "orientation": "portrait",
    "scheme": "carepop",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carepop.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/carepop-logo-blue.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.carepop.mobile",
      "edgeToEdgeEnabled": true,
      "supabaseUrl": "https://lpaqfvfuzfqsrciawipu.supabase.co"
    },
    "web": {
      "favicon": "./assets/carepop-logo-blue.png"
    },
    "assetBundlePatterns": [
      "assets/*",
      "src/data/psgc/*"
    ],
    "extra": {
      "eas": {
        "projectId": "42305f69-4bf4-4559-b9d3-500ad85b7a11"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ]
  }
}
