{
  "expo": {
    "name": "CarePop Mobile",
    "slug": "carepop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/carepop-logo-pink.png",
    "scheme": "carepop",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carepop.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby clinics and provide you with accurate directions.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.92849154218-ihqat9lglvl9c0nsv0qugds2io6rv4c2"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.92849154218-ihqat9lglvl9c0nsv0qugds2io6rv4c2"
            ]
          }
        ]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/carepop-logo-blue.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.carepop.mobile",
      "edgeToEdgeEnabled": true,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/carepop-logo-blue.png"
    },
    "assetBundlePatterns": [
      "assets/*",
      "src/data/psgc/*"
    ],
    "extra": {
      "eas": {
        "projectId": "42305f69-4bf4-4559-b9d3-500ad85b7a11"
      }
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-router"
    ],
    "updates": {
      "url": "https://u.expo.dev/42305f69-4bf4-4559-b9d3-500ad85b7a11"
    }
  }
}
