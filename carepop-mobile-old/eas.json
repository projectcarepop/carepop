{
  "cli": {
    "version": ">= 16.4.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
        "EXPO_PUBLIC_MAPBOX_API_KEY": "${EXPO_PUBLIC_MAPBOX_API_KEY}"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
        "EXPO_PUBLIC_MAPBOX_API_KEY": "${EXPO_PUBLIC_MAPBOX_API_KEY}"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}",
        "EXPO_PUBLIC_MAPBOX_API_KEY": "${EXPO_PUBLIC_MAPBOX_API_KEY}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
